    .grid-2 { display:grid; grid-template-columns:1fr 1.2fr; gap:30px; align-items:center; }
    @media (max-width:700px) { .grid-2 { grid-template-columns:1fr; gap:18px; } }
    .img-wrapper { border-radius:40px 12px 40px 12px; overflow:hidden; box-shadow:0 12px 18px -6px #3a6b60; background:#b5d3c9; transition:0.25s; }
    .img-wrapper img { width:100%; height:220px; object-fit:cover; display:block; transition:0.3s; }
    .img-wrapper:hover img { transform:scale(1.03); }
    .text-content { background:rgba(225,240,230,0.3); padding:18px 22px; border-radius:30px 8px 30px 8px; border-left:6px solid #f5b7c9; backdrop-filter:blur(2px); }
